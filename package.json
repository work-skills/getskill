{
    "name": "@workskills/getskill",
    "description": "A skill management CLI for any AI agent (Claude Code, OpenClaw, Codex, Cursor, or a custom skills directory) that searches, installs, and updates skill files from the getskill.work registry",
    "version": "3.3.0",
    "main": "dist/main.js",
    "types": "dist/main.d.ts",
    "bin": {
        "getskill": "dist/main.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "npm run test:unit && npm run verify",
        "test:unit": "vitest run --config vitest.config.ts",
        "test:watch": "vitest --config vitest.config.ts",
        "test:flow": "tsx test-pdf-flow.ts",
        "test:smoke": "npm run build && node test-full-smoke.mjs",
        "verify": "tsx verify.ts",
        "lint": "eslint . --ext .js,.ts && prettier --check .",
        "lint:fix": "eslint . --ext .js,.ts --fix && prettier --write .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "coverage": "vitest run --config vitest.config.ts --coverage",
        "start": "node dist/main.js",
        "dev": "tsx main.ts",
        "prepublishOnly": "npm run build && npm run lint && npm test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/work-skills/getskill.git"
    },
    "bugs": {
        "url": "https://github.com/work-skills/getskill/issues"
    },
    "homepage": "https://github.com/work-skills/getskill#readme",
    "keywords": [
        "agent",
        "agents",
        "agent-skills",
        "openclaw",
        "workskills",
        "skill",
        "skills",
        "search",
        "install",
        "update",
        "cli",
        "claude",
        "claude-code",
        "codex",
        "cursor",
        "ai",
        "automation"
    ],
    "author": {
        "name": "workskills.store",
        "url": "https://workskills.store"
    },
    "license": "MIT",
    "engines": {
        "node": ">=18.0.0"
    },
    "os": [
        "darwin",
        "linux",
        "win32"
    ],
    "files": [
        "dist/main.js",
        "dist/main.d.ts",
        "dist/lib/",
        "README.md",
        "EXAMPLES.md",
        "LICENSE"
    ],
    "dependencies": {},
    "devDependencies": {
        "@types/node": "^24.6.1",
        "@typescript-eslint/eslint-plugin": "^8.46.1",
        "@typescript-eslint/parser": "^8.46.1",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.0",
        "prettier": "^3.6.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    }
}
