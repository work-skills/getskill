{
    "compilerOptions": {
        "target": "ES2020",
        "module": "CommonJS",
        "moduleResolution": "node",
        "lib": ["ES2020"],
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "declaration": true,
        "outDir": "dist",
        "rootDir": ".",
        "types": ["node", "vitest/globals"]
    },
    "include": [
        "main.ts",
        "verify.ts",
        "test-pdf-flow.ts",
        "lib/**/*.ts",
        "tests/**/*.ts",
        "vitest.config.ts"
    ],
    "exclude": ["node_modules", "dist", "clawhub", "Claw-CLI"]
}
