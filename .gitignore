# Exclude hidden files and directories
.*
!.gitignore
!.github/
!.eslintrc.cjs
!.prettierrc.json
!.prettierignore

# Exclude node_modules
node_modules/

# Exclude logs
*.log
logs/

# Exclude OS files
.DS_Store
Thumbs.db

# Exclude build output
dist/
build/
*.tsbuildinfo

# Exclude test files
test/
*.test.js
*.spec.js

# Keep project documentation tracked

# Exclude package files
package-lock.json
npmuser.txt
*.tgz

# Exclude sensitive credentials / temp publish artifacts (never commit)
.npmrc
.npm_user.txt
npmlogin*.txt
publish_out.txt
rebuild.txt
test_result.md

# Keep publish/runtime essentials tracked
!package.json
!LICENSE
!EXAMPLES.md

# But track .gitignore itself
!.gitignore